# 乱记同步服务环境变量示例 —— 只含占位值，不含任何真实密钥。
# 复制为 .env 后按需修改；compose.yaml 默认不需要任何必填项。
# 说明与默认值详见 docs/sync-deployment.md 与 docs/sync-protocol-v1.md。

# 数据目录（容器内路径，一般不改）
LUANJI_DATA_DIR=/data

# 监听地址与端口（容器内；对外由反向代理提供 HTTPS）
LUANJI_HOST=0.0.0.0
LUANJI_PORT=8390

# 记录与附件限制（与服务端、插件端、README 保持一致）
LUANJI_MAX_TEXT_CHARS=20000
LUANJI_MAX_ATTACHMENTS=6
LUANJI_MAX_BLOB_BYTES=2097152
LUANJI_QUOTA_BYTES=5368709120

# 请求防护
LUANJI_RATE_LIMIT_PER_MINUTE=300
LUANJI_LOGIN_MAX_FAILURES=10
LUANJI_LOGIN_WINDOW_MINUTES=15

# 备份
LUANJI_SNAPSHOT_HOUR=3
LUANJI_SNAPSHOT_KEEP=7
